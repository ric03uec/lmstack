# lmstack environment file — CHANGE_ME_HOST.
#
# The playbook copies this to <install_root>/stack.env on the target host
# the first time it runs, chmod 600, and NEVER overwrites it afterwards. Fill
# the three values below and re-run `make up`.
#
# Real .env files are gitignored. Only this .example is tracked. Nothing here
# is read by the lmstack skill, and none of it reaches .stacklog.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# HuggingFace read token, needed for gated repositories.
#   https://huggingface.co/settings/tokens
HF_TOKEN=

# The bearer token your clients send to the gateway. Any random string works;
# the sk- prefix is convention, not a requirement.
#   printf 'sk-%s\n' "$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# Postgres password behind the LiteLLM UI and spend logs. Compose substitutes
# it into both the postgres container and the gateway's DATABASE_URL, so the UI
# reports "Not connected to DB!" if it is blank.
#   openssl rand -hex 24
LITELLM_DB_PASSWORD=
