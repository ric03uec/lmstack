74m│\u001b[6;1H│\u001b[39m                      \u001b[38;5;174m▝▜\u001b[48;5;16m█████\u001b[49m▛▘\u001b[39m                     \u001b[38;5;174m\u001b[2m│\u001b[m\u000f Added agent view (Research Preview): a single list of every Claude Code session — running, blocked on you, or done. Run `claude agents` to get started. See https://code.claude.c… \u001b[38;5;174m│\u001b[7;1H│\u001b[39m                        \u001b[38;5;174m▘▘\u001b[39m \u001b[38;5;174m▝▝\u001b[39m                       \u001b[38;5;174m\u001b[2m│\u001b[m\u000f Added `/goal` command: set a completion condition and Claude keeps working across turns until it's met. Works in interactive, `-p`, and Remote Control. Shows live elapsed/turns/… \u001b[38;5;174m│\u001b[8;1H│\u001b[39m   \u001b[38;5;246mclaude-opus-5\u001b[39m \u001b[38;5;246mwith\u001b[39m \u001b[38;5;246mhigh\u001b[39m \u001b[38;5;246meffort\u001b[39m \u001b[38;5;246m·\u001b[39m \u001b[38;5;246mClaude\u001b[39m \u001b[38;5;246mMax\u001b[39m \u001b[38;5;246m·\u001b[39m    \u001b[38;5;174m\u001b[2m│\u001b[m\u000f Added `/scroll-speed` command to tune mouse wheel scroll speed with a live preview                                                                                                 \u001b[38;5;174m│\u001b[9;1H│\u001b[39m   \u001b[38;5;246mDevashish\u001b[39m \u001b[38;5;246mMeena\u001b[39m                                  \u001b[38;5;174m\u001b[2m│\u001b[m\u000f \u001b[38;5;246m\u001b[3m/release-notes\u001b[m\u000f \u001b[38;5;246m\u001b[3mfor\u001b[m\u000f \u001b[38;5;246m\u001b[3mmore\u001b[m\u000f                                                                                                                                                            \u001b[38;5;174m│\u001b[10;1H│\u001b[39m            \u001b[38;5;246m~/workspace/ric03uec/lmstack\u001b[39m            \u001b[38;5;174m\u001b[2m│\u001b[m\u000f                                                                                                                              "]
