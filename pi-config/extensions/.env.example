# lmstack provider configuration for pi.
#
# sync.sh copies this to ~/.pi/agent/extensions/.env on the first install and
# never touches it again, in either direction. Fill in the hosts you actually
# have; an unset provider registers and then fails to connect, which is a
# clearer signal than one that quietly disappears from --list-models.
#
# The key is the LITELLM_MASTER_KEY from the target host's stack.env. Read it on
# the host, not from here:
#
#   ssh h1-nvidia 'grep ^LITELLM_MASTER_KEY ~/.lmstack/stack.env | cut -d= -f2'
#
# This file holds a credential. Keep it mode 0600 and out of git.

# --- h1-nvidia (vLLM) ------------------------------------------------------
# LMSTACK_H1_URL defaults to http://h1-nvidia:4000/v1, which assumes an
# ~/.ssh/config alias or a Tailscale name. Use the Tailscale IP if neither
# resolves.
#LMSTACK_H1_URL=http://100.64.0.2:4000/v1
#LMSTACK_H1_KEY=sk-...

# --- h2-amd (llama.cpp) ----------------------------------------------------
# Defaults to loopback, which is right when h2-amd is this machine.
#LMSTACK_H2_URL=http://127.0.0.1:4000/v1
#LMSTACK_H2_KEY=sk-...
